# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Redis (Celery broker + result backend) ───────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_SECRET_KEY=<random-32-byte-hex>
ALLOWED_ORIGINS=http://localhost:3000

# ── Connectors — Gmail / Google Workspace ────────────────────────────────────
GOOGLE_CLIENT_ID=<oauth-client-id>
GOOGLE_CLIENT_SECRET=<oauth-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:8000/connectors/google/callback

# ── Connectors — HubSpot ─────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=<private-app-token>
HUBSPOT_WEBHOOK_SECRET=<webhook-verify-token>

# ── Connectors — Asana ───────────────────────────────────────────────────────
ASANA_ACCESS_TOKEN=<personal-access-token>

# ── Connectors — Slack ───────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=<signing-secret>

# ── Connectors — QuickBooks ──────────────────────────────────────────────────
QUICKBOOKS_CLIENT_ID=<client-id>
QUICKBOOKS_CLIENT_SECRET=<client-secret>
QUICKBOOKS_REALM_ID=<realm-id>
QUICKBOOKS_REFRESH_TOKEN=<refresh-token>

# ── Connectors — Harvest ─────────────────────────────────────────────────────
HARVEST_ACCESS_TOKEN=<personal-access-token>
HARVEST_ACCOUNT_ID=<account-id>

# ── Notifications ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
NOTIFICATION_EMAIL_FROM=ai-brain@northpath.example.com

# ── Cockpit ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
